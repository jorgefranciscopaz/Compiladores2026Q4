# Looks for the techniques that Lab 1 forbids (Lab1.md, section 4). Provided: do not modify.
#
#   cmake -DSRC_DIR=<src folder> -P tools/CheckRules.cmake
#
# The lexer must be hand-written from the DFA and the parser must be hand-written recursive
# descent: no <regex>, no scanner generated by RE/flex, no parser generator or library.
# `//` comments are ignored, so you may write about these things in comments.
# This is a safety net for the obvious cases, not a proof; the rules of section 4 are the rules.
cmake_minimum_required(VERSION 3.20)

if("${SRC_DIR}" STREQUAL "")
  message(FATAL_ERROR "usage: cmake -DSRC_DIR=<src> -P tools/CheckRules.cmake")
endif()

file(GLOB sources "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.cc" "${SRC_DIR}/*.hpp" "${SRC_DIR}/*.h")
if(NOT sources)
  message(FATAL_ERROR "no source files found in ${SRC_DIR}")
endif()

set(forbidden
  "include[ \t]*<regex>"        # std::regex
  "std::[a-z_]*regex"           # std::regex, std::sregex_iterator, ...
  "lex\\.yy"                    # the scanner generated by RE/flex
  "reflex/"                     # the RE/flex runtime library
  "flexlexer"                   # the flex runtime
  "bison"
  "yacc"
  "antlr"
  "lemon"
  "peglib"
  "boost/spirit"
)

set(problems "")
foreach(source IN LISTS sources)
  file(READ "${source}" text)
  string(REGEX REPLACE "//[^\n]*" "" text "${text}")
  string(TOLOWER "${text}" lower)
  foreach(pattern IN LISTS forbidden)
    if(lower MATCHES "${pattern}")
      get_filename_component(name "${source}" NAME)
      string(APPEND problems "  - src/${name} uses something forbidden (matches '${pattern}')\n")
    endif()
  endforeach()
endforeach()

if(NOT "${problems}" STREQUAL "")
  message(FATAL_ERROR "forbidden techniques found:\n${problems}Lexer: hand-written DFA. Parser: hand-written recursive descent. See Lab1.md, section 4.")
endif()
message(STATUS "rules OK: no regex, generated scanner or parser generator in src/")
